# ==========================================
# In Work AI Platform - Environment Variables
# ==========================================

# [Supabase Configuration]
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [Map Configuration]
# Default center for Ismailia, Egypt
NEXT_PUBLIC_DEFAULT_LAT=30.5965
NEXT_PUBLIC_DEFAULT_LNG=32.2715

# [Payment Gateways]
# Set to 'true' in production
NEXT_PUBLIC_ENABLE_INSTAPAY=false
